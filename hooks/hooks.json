{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/session-hook.py\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "mcp__plugin_archetype_core__(start_run|report_result)",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/action-hook.py\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "mcp__playwright__.*|mcp__claude-in-chrome__.*|mcp__plugin_archetype_archetype-(browser|watch)-[0-9]+__.*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/action-hook.py\"",
            "async": true,
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "mcp__playwright__.*|mcp__claude-in-chrome__.*|mcp__plugin_archetype_archetype-(browser|watch)-[0-9]+__.*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/action-hook.py\"",
            "async": true,
            "timeout": 10
          }
        ]
      }
    ]
  }
}
